ORIONXCORE_APP_NAME=OrionXCore
ORIONXCORE_HOST=0.0.0.0
ORIONXCORE_PORT=18080
ORIONXCORE_MODEL=deepseek-v4-flash
ORIONXCORE_API_KEY=sk-xxx
ORIONXCORE_API_BASE_URL=https://api.xxx.com
ORIONXCORE_SYSTEM_PROMPT=You are OrionXCore, a lightweight AI coding agent.
ORIONXCORE_MAX_ITERATIONS=20
ORIONXCORE_HTTP_TIMEOUT=120
ORIONXCORE_ENABLE_TERMINAL=false
ORIONXCORE_ENABLE_DATABASE=true
ORIONXCORE_ENABLE_FILESYSTEM=true
ORIONXCORE_FILESYSTEM_WORKDIR=./workspace
ORIONXCORE_FILESYSTEM_ALLOW_WRITE=true
ORIONXCORE_FILESYSTEM_ALLOW_DELETE=false
ORIONXCORE_TERMINAL_WORKDIR=.
ORIONXCORE_TERMINAL_TIMEOUT=30
ORIONXCORE_ALLOW_RISKY_COMMANDS=false
ORIONXCORE_DATABASE_URL=clickhousedb://default:password@clickhouse_ip:port/database
ORIONXCORE_DATABASE_MAX_ROWS=200
ORIONXCORE_DATABASE_QUERY_TIMEOUT_SECONDS=30
ORIONXCORE_DATABASE_ALLOW_MUTATION=false
ORIONXCORE_DATABASE_ALLOWED_DATABASES=monitor,maintaindata,topology
ORIONXCORE_FILESYSTEM_MAX_READ_BYTES=5242880
