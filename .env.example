ORIONXCORE_APP_NAME=OrionXCore
ORIONXCORE_HOST=0.0.0.0
ORIONXCORE_PORT=8080
ORIONXCORE_MODEL=gpt-4.1-mini
ORIONXCORE_API_KEY=your_api_key
ORIONXCORE_API_BASE_URL=https://api.openai.com/v1
ORIONXCORE_SYSTEM_PROMPT=You are OrionXCore, a lightweight AI coding agent.
ORIONXCORE_MAX_ITERATIONS=6
ORIONXCORE_HTTP_TIMEOUT=120

# 日志配置
ORIONXCORE_LOG_LEVEL=INFO
ORIONXCORE_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
ORIONXCORE_LOG_FILE=

# Terminal tool 配置
ORIONXCORE_ENABLE_TERMINAL=true
ORIONXCORE_TERMINAL_WORKDIR=.
ORIONXCORE_TERMINAL_TIMEOUT=30
ORIONXCORE_ALLOW_RISKY_COMMANDS=false

# Database tool 配置
ORIONXCORE_ENABLE_DATABASE=false
ORIONXCORE_DATABASE_URL=clickhousedb://username:password@localhost:8123/default
ORIONXCORE_DATABASE_MAX_ROWS=200
ORIONXCORE_DATABASE_QUERY_TIMEOUT_SECONDS=30
ORIONXCORE_DATABASE_ALLOW_MUTATION=false
ORIONXCORE_DATABASE_ALLOWED_DATABASES=default,analytics

# Alert query tool (EOP /api/alerts, read-only)
ORIONXCORE_ENABLE_ALERT=false
ORIONXCORE_ALERT_DATABASE_URL=postgresql+psycopg2://user:password@host:5432/ismp
ORIONXCORE_ALERT_DATABASE_TIMEOUT_SECONDS=30
ORIONXCORE_ALERT_DEFAULT_WINDOW_MINUTES=30
ORIONXCORE_ALERT_TOP_N=10
ORIONXCORE_ALERT_TIMEZONE=Asia/Shanghai

# Metrics query tool (ClickHouse, read-only)
# Note: Use HTTP port 8123 (not native port 9000)
# Password special characters need URL encoding: # -> %23, @ -> %40, etc.
ORIONXCORE_ENABLE_METRICS=false
ORIONXCORE_METRICS_DATABASE_URL=clickhouse://user:password@host:8123/metrics
ORIONXCORE_METRICS_DATABASE_TIMEOUT_SECONDS=30
ORIONXCORE_METRICS_TIMEZONE=Asia/Shanghai
ORIONXCORE_METRICS_DEFAULT_WINDOW_MINUTES=30

# Filesystem tool 配置
ORIONXCORE_ENABLE_FILESYSTEM=false
ORIONXCORE_FILESYSTEM_ALLOW_WRITE=true
ORIONXCORE_FILESYSTEM_ALLOW_DELETE=false
ORIONXCORE_FILESYSTEM_MAX_READ_BYTES=1048576
ORIONXCORE_FILESYSTEM_MAX_WRITE_BYTES=1048576
ORIONXCORE_FILESYSTEM_MAX_LIST_ENTRIES=500

# Chart tool 配置
ORIONXCORE_ENABLE_CHART=true
ORIONXCORE_CHART_WORKDIR=
ORIONXCORE_CHART_MAX_WIDTH=1920
ORIONXCORE_CHART_MAX_HEIGHT=1080
ORIONXCORE_CHART_DEFAULT_DPI=100
ORIONXCORE_CHART_FONT_FAMILY=

# Upload tool 配置
ORIONXCORE_ENABLE_UPLOAD=true
ORIONXCORE_UPLOAD_MAX_SIZE_MB=10
ORIONXCORE_UPLOAD_ALLOWED_EXTENSIONS=.txt,.csv,.json,.md,.py,.log,.yaml,.yml,.xml,.html,.js,.ts,.sql,.sh,.cfg,.ini,.conf,.toml,.rst
ORIONXCORE_UPLOAD_WORKDIR=
