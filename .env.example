# Environment variables override values in config.toml.
# Use nested names with a double underscore between section and field.

# Sensitive values should be provided through the environment or a secret store.
ORIONXCORE_LLM__API_KEY=your_api_key

# Optional overrides
ORIONXCORE_CONFIG_FILE=./config.toml
# ORIONXCORE_LLM__MODEL=gpt-4.1-mini
# ORIONXCORE_LLM__API_BASE_URL=https://api.openai.com/v1
# ORIONXCORE_SERVER__PORT=8080
# ORIONXCORE_TERMINAL__ENABLED=true
