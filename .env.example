# Model credentials should be provided through the environment.
ORIONXCORE_LLM__API_KEY=
# Or mount a Docker Secret and set ORIONXCORE_LLM__API_KEY_FILE=/run/secrets/llm_api_key

# Optional runtime API authentication. Enable auth in config.toml first.
# ORIONXCORE_AUTH__ENABLED=true
# ORIONXCORE_AUTH__API_KEYS='["replace-with-a-long-random-key"]'
# CLI calls can use RILL_API_KEY=replace-with-a-long-random-key

# Optional alternate configuration file.
# ORIONXCORE_CONFIG_FILE=./config.toml
